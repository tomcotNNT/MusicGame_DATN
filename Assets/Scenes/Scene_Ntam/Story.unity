  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StorySceneController
  backgroundA: {fileID: 577077365}
  backgroundB: {fileID: 572569869}
  stageTitleText: {fileID: 1463010299}
  storyContentText: {fileID: 1891329916}
  nextButton: {fileID: 578263360}
  fadePanel: {fileID: 926703594}
  displayDuration: 4
  fadeDuration: 1.5
  stages:
  - stageTitle: Tutorial
    storyContent: "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi Tutorial City.Nh\u1EEFng
      d\u1EA3i t\u1EA7n s\u1ED1 \xE2m thanh \u0111\u1EA7u ti\xEAn \u0111\xE3 th\u1EE9c
      t\u1EC9nh tr\xEAn b\u1EA7u tr\u1EDDi th\xE0nh ph\u1ED1.\n\nH\xE3y l\xE0m quen
      v\u1EDBi nh\u1ECBp \u0111i\u1EC7u: L\u1EAFng nghe giai \u0111i\u1EC7u v\xE0
      b\u1EA5m chu\u1EA9n x\xE1c 2 l\xE0n ph\xEDm [Tr\xE1i] - [Ph\u1EA3i] \u0111\u1EC3
      thu th\u1EADp n\u1ED1t n\u0103ng l\u01B0\u1EE3ng.\n\nB\u1EA5m NEXT \u0111\u1EC3
      b\u1EAFt \u0111\u1EA7u b\xE0i hu\u1EA5n luy\u1EC7n!"
    background1: {fileID: 21300000, guid: a92357b50e7cc6347abdd05f6fc3e833, type: 3}
    background2: {fileID: 21300000, guid: 54e68cda7ed7d264f9a4e4c7ddc0dee6, type: 3}
    targetGameplayScene: Tutorial
  - stageTitle: 1.New York City
    storyContent: "Th\xE0nh ph\u1ED1 New York t\u01B0\u01A1ng lai \u0111ang b\u1ECB
      bao ph\u1EE7 b\u1EDFi nh\u1EEFng \u0111\u1EE3t s\xF3ng \xE2m h\u1ED7n lo\u1EA1n.\n\nV\u1EDBi
      t\u01B0 c\xE1ch l\xE0 m\u1ED9t Beat Runner, nhi\u1EC7m v\u1EE5 c\u1EE7a b\u1EA1n
      l\xE0 b\xE1m s\xE1t t\u1EEBng nh\u1ECBp \u0111i\u1EC7u, thu th\u1EADp to\xE0n
      b\u1ED9 c\xE1c h\u1EA1t n\u0103ng l\u01B0\u1EE3ng \xE2m nh\u1EA1c v\xE0 \u0110\u1EEBng
      \u0111\u1EC3 b\u1EA5t k\u1EF3 n\u1ED1t nh\u1EA1c n\xE0o tr\xF4i qua!\n\nH\xE3y
      s\u1EB5n s\xE0ng b\u1EE9t t\u1ED1c v\xE0 l\xE0m ch\u1EE7 \u0111\u01B0\u1EDDng
      \u0111ua!"
    background1: {fileID: 21300000, guid: b75c4d643bcd95e4bafa6b07f27eb5a8, type: 3}
    background2: {fileID: 21300000, guid: 65c6cfceeb66d1a43a7bb944f8c68454, type: 3}
    targetGameplayScene: Man1
  - stageTitle: 
